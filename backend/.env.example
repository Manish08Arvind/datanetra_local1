PORT=4000
DATABASE_URL=postgres://user:password@host:5432/msme_db
JWT_SECRET=replace_with_secure_secret
OTP_EXPIRY_MINUTES=10

# SMTP settings for sending OTP emails
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="MSME Onboarding" <no-reply@yourdomain.com>

# First-time admin (creators/employees); creates row in admin_users on first login
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_secure_password

# Optional: Ollama for analytics assistant (local LLM). Install Ollama, run e.g. ollama run llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

